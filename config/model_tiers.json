    ],
    "lite_keywords": [
      "flash-lite",
      "flash_lite",
      "lite",
      "8b",
      "nano",
      "mini",
      "haiku"
    ],
    "excluded_keywords": [
      "embedding",
      "imagen",
      "veo",
      "aqa",
      "tts",
      "audio",
      "vision-only",
      "image",
      "placeholder"
    ]
  },
